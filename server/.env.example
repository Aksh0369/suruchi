# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (the Flutter app doesn't
# send an Origin header, so this mainly matters for local curl/testing tools)
CORS_ORIGIN=http://localhost:4000

# ---- Database ----
# Local:  postgresql://postgres:postgres@localhost:5432/reminder_app
# Neon:   paste the connection string from your Neon project dashboard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reminder_app
# Neon (and Render's own Postgres) needs SSL; local usually does not
DB_SSL=false

# ---- Auth ----
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ---- Seed (only used by `npm run seed`) ----
SEED_USER1_USERNAME=suhrad
SEED_USER1_NAME=Me
SEED_USER1_PIN=1234
SEED_USER2_USERNAME=wife
SEED_USER2_NAME=Wife
SEED_USER2_PIN=5678
